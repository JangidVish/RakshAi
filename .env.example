# PostgreSQL connection string (get a free one from https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API key (Week 3 — AI risk summaries). Without it, a deterministic
# dev stub is used so the flow still works locally.
OPENAI_API_KEY="sk-..."
# Model override (default: gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"

# Invite code required to register a Buyer/CISO account (server-enforced).
# Generate with: openssl rand -hex 16
BUYER_INVITE_CODE="replace-with-a-random-code"

# Resend API key for outbound email (invites, review notifications).
# Without it, emails and invite links are logged to the server console.
RESEND_API_KEY=""
# Verified sender address, e.g. "RakshAI <no-reply@your-domain.com>"
MAIL_FROM=""
