# PostgreSQL connection string (get a free one from https://neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key (needed in Week 3 for AI risk summaries)
ANTHROPIC_API_KEY="sk-ant-..."

# Invite code required to register a Buyer/CISO account (server-enforced).
# Generate with: openssl rand -hex 16
BUYER_INVITE_CODE="replace-with-a-random-code"
